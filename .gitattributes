# Exclude development files from Git archives (used by GitHub releases)
# These files will not be included when GitHub creates release zip files

# Scripts folder
scripts/ export-ignore

# Resources folder
resources/ export-ignore

# GitHub Actions
.github/ export-ignore

# Documentation
docs/ export-ignore

# Development files
.gitignore export-ignore
release-please-config.json export-ignore
*.md export-ignore
version.txt export-ignore

# PowerShell scripts in root (if any)
*.ps1 export-ignore
